NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signed Clerk webhook endpoint: /api/webhooks/clerk
CLERK_WEBHOOK_SIGNING_SECRET=

# Public GA4 web-stream measurement ID (for example, G-XXXXXXXXXX).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_AMM_ENV=local

# Public PostHog project token and ingestion host. Session replay and DOM
# autocapture are deliberately disabled; AMM sends pageviews + named events.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Runtime environment is separate from NODE_ENV: Cloud Run dev still runs an
# optimized Next.js production build.
AMM_ENV=local
APP_BASE_URL=http://localhost:3000
# `shared` means production Firestore/Clerk/analytics are intentionally common.
# Non-production startup fails closed unless mutations remain guarded.
AMM_DATA_MODE=shared
AMM_DEV_USER_ALLOWLIST=
AMM_DEV_FLEET_TOKEN=
AMM_DEV_WEBHOOK_TOKEN=

DESK_STORE=firestore
# Sent to SEC EDGAR and news feeds, which ask every client to name a contact.
CONTACT_USER_AGENT="MyDesk/1.0 (you@example.com)"
CRON_TOKEN=

OPENROUTER_API_KEY=
LLMC3_COUNCIL_URL=
INTERNAL_COUNCIL_TOKEN=

# Configure at least one licensed news provider in production.
BENZINGA_API_KEY=
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
TIINGO_API_TOKEN=
MASSIVE_API_KEY=
# Backwards-compatible key name for existing Polygon accounts.
POLYGON_API_KEY=
ENABLE_GDELT_DISCOVERY=false
STORE_LICENSED_NEWS_SUMMARIES=false
STORE_LICENSED_NEWS_PAYLOADS=false

RESEND_API_KEY=
# Separate Resend key with contacts/segments/topics access. Keep the primary
# RESEND_API_KEY send-only.
RESEND_CONTACTS_API_KEY=
# Signed Resend event endpoint: /api/webhooks/resend
RESEND_WEBHOOK_SECRET=
# Optional Resend Audiences objects. Firestore remains the source of truth.
RESEND_SEGMENT_ONBOARDING=
RESEND_SEGMENT_ACTIVE_DESK=
RESEND_TOPIC_ONBOARDING=
RESEND_TOPIC_MORNING_NOTES=
NOTE_FROM="AMM · The Desk <desk@aftermarketmovers.com>"
# Outbound Morning Notes are fail-closed unless explicitly enabled.
AMM_EMAILS_ENABLED=false
# Required whenever AMM_EMAILS_ENABLED=true outside production.
EMAIL_SINK_OVERRIDE=
# Dedicated HMAC key for stable unsubscribe links. Keep CRON_TOKEN only as the
# migration verifier for links that were already delivered.
UNSUBSCRIBE_SECRET=
# Required for every outbound commercial Morning Note. Use the exact valid
# physical postal address approved for Evolo Pty Ltd communications.
COMPANY_POSTAL_ADDRESS=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ULTRA=
# disabled | test | live. Non-production rejects live keys.
AMM_BILLING_MODE=disabled
